# CropIQ FastAPI Backend Environment Configuration
ENVIRONMENT=development
APP_NAME=CropIQ API
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Paths (relative to project root or absolute)
MODEL_PATH=models/cropiq_yield_model.joblib
MODEL_METADATA_PATH=models/model_metadata.json
SCENARIO_METADATA_PATH=knowledge/scenario_features.json
AGRICULTURAL_RULES_PATH=knowledge/agricultural_rules.json

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000
